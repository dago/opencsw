-     
-           ...
-     
-           /* Open the file and make sure nc_inq_varids yeilds correct
-            * result. */
-           if (nc_open(FILE_NAME, NC_NOWRITE, &amp;ncid)) ERR;
-           if (nc_inq_varids(ncid, &amp;nvars_in, varids_in)) ERR;
